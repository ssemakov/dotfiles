#!/usr/bin/env bash

# Refuse to silently drop the sandbox, especially for full-access ACP agents.
if ! command -v safehouse >/dev/null 2>&1; then
  echo "safe: Safehouse is required; refusing to run unsandboxed." >&2
  exit 127
fi

safehouse_profile="$HOME/.config/agent-safehouse/local-overrides.sb"
if [[ ! -f "$safehouse_profile" ]]; then
  echo "safe: Missing policy: $safehouse_profile; refusing to run." >&2
  exit 1
fi

safehouse_args=(--add-dirs-ro="$HOME/workspace")
cmd_args=()

safehouse_rw_dirs=(
  "$HOME/.crit"
)

safehouse_args+=(--append-profile="$safehouse_profile")

for dir in "${safehouse_rw_dirs[@]}"; do
  [[ -d "$dir" ]] && safehouse_args+=(--add-dirs="$dir")
done

while (( $# )); do
  case "$1" in
    --)
      shift
      cmd_args+=("$@")
      break
      ;;
    --add-dir)
      shift
      if (( $# == 0 )); then
        echo "safe: --add-dir requires a directory argument" >&2
        exit 1
      fi
      safehouse_args+=(--add-dirs-ro="$1")
      ;;
    --add-dir=*)
      safehouse_args+=(--add-dirs-ro="${1#--add-dir=}")
      ;;
    --add-dir-rw)
      shift
      if (( $# == 0 )); then
        echo "safe: --add-dir-rw requires a directory argument" >&2
        exit 1
      fi
      safehouse_args+=(--add-dirs="$1")
      ;;
    --add-dir-rw=*)
      safehouse_args+=(--add-dirs="${1#--add-dir-rw=}")
      ;;
    --enable)
      shift
      if (( $# == 0 )); then
        echo "safe: --enable requires a feature argument" >&2
        exit 1
      fi
      safehouse_args+=(--enable="$1")
      ;;
    --enable=*)
      safehouse_args+=("$1")
      ;;
    *)
      cmd_args+=("$1")
      ;;
  esac
  shift
done

exec safehouse "${safehouse_args[@]}" -- "${cmd_args[@]}"
