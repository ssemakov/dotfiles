#!/usr/bin/env bash
# tsave [-t <target-window>] — save a tmux window's pane layout.
# tsave list                  — list stored layouts (session:index, pane count).
# Keyed by <session>/<window-index>. Overwrites the current save; keeps exactly
# one prior copy as <index>.bak. No deeper history.
set -eo pipefail

base="${XDG_DATA_HOME:-$HOME/.local/share}/tmux-layouts"

if [ "${1:-}" = list ]; then
  [ -d "$base" ] || { echo "(no stored layouts)"; exit 0; }
  find "$base" -type f ! -name '*.bak' | sort | while read -r f; do
    # A pane leaf is WxH,X,Y,ID (4th field numeric); a container's 4th is {/[.
    n=$(grep -oE '[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+' "$f" | wc -l | tr -d ' ')
    key=${f#"$base"/}
    printf '%-20s %s panes\n' "${key/\//:}" "$n"
  done
  exit 0
fi

targ=()
[ "${1:-}" = "-t" ] && targ=(-t "$2")

# One resolve per field — session names can contain spaces, so don't parse a
# single delimited string.
get() { tmux display-message -p "${targ[@]}" "$1"; }
session=$(get '#{session_name}')
index=$(get '#{window_index}')
layout=$(get '#{window_layout}')

# ponytail: filename is the raw session name; a '/' in it would break the path.
# Session names are almost never pathological — swap to a sanitized key if that
# ever bites.
dir="$base/$session"
mkdir -p "$dir"
file="$dir/$index"

[ -f "$file" ] && cp -f "$file" "$file.bak"   # single rolling backup
printf '%s\n' "$layout" >"$file"
