# Auto-install Ghostty's terminfo on remote hosts over SSH (and fall back to a
# safe TERM if it can't) so tmux/nvim work on boxes that lack xterm-ghostty.
shell-integration-features = cursor,title,ssh-env,ssh-terminfo

theme = TokyoNight Night

# Match iTerm-style true-black background so tmux colors pop
# (set after `theme` so it overrides the theme's background)
background = 000000

# Cmd+Shift+I prompts for a tab name; a tab-level title outranks the
# shell-integration title updates, so it sticks.
keybind = cmd+shift+i=prompt_tab_title

# Cmd+` is owned by ~/.config/svim/terminal-toggle.sh --install. The helper
# stops SketchyVim before showing this panel and restores it after dismissal.
# Remove Ghostty's default window-cycling binding for this shortcut too.
keybind = cmd+backquote=unbind
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
